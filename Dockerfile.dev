FROM golang:1.26.1-alpine

ARG AIR_VERSION=v1.63.0

ENV GO111MODULE=on \
    CGO_ENABLED=0 \
    GOEXPERIMENT=greenteagc \
    GOWORK=off

RUN apk add --no-cache ca-certificates git tzdata && \
    go install github.com/air-verse/air@${AIR_VERSION}

WORKDIR /workspace

# Cache backend dependencies in the remotely built workspace image. Business
# source is supplied by the bind mount when the container starts.
COPY go.mod go.sum ./
COPY relaykit/go.mod relaykit/go.sum ./relaykit/
RUN go mod download

COPY --chmod=755 dev/dev-api-entrypoint.sh /usr/local/bin/dev-api-entrypoint

EXPOSE 3000

ENTRYPOINT ["dev-api-entrypoint"]
CMD ["air", "-c", ".air.toml"]
