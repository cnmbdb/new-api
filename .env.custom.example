# Copy to .env.custom and load it with:
# docker compose --env-file .env.custom -f compose.custom.yml up -d --build

CUSTOM_IMAGE=ghcr.io/cnmbdb/new-api:custom
# Pin an immutable official image digest in production.
OFFICIAL_RUNTIME=calciumion/new-api:latest
APP_PORT=3000
TZ=Asia/Shanghai
NODE_NAME=new-api-custom-1

SQL_DSN=postgresql://USER:PASSWORD@HOST:5432/DATABASE
REDIS_CONN_STRING=redis://USER:PASSWORD@HOST:6379/0
SESSION_SECRET=replace-with-at-least-32-random-characters

# Conservative defaults for Railway/small managed databases.
SQL_MAX_IDLE_CONNS=5
SQL_MAX_OPEN_CONNS=25
SQL_MAX_LIFETIME=300
