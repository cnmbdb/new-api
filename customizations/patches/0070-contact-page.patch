+import { useTranslation } from 'react-i18next'
+
+import { IconWeChat } from '@/assets/brand-icons'
+import { PublicLayout } from '@/components/layout'
+import { Footer } from '@/components/layout/components/footer'
+
+export function Chat() {
+  const { t } = useTranslation()
+
+  return (
+    <PublicLayout showMainContainer={false}>
+      <div className='relative flex min-h-svh flex-col overflow-hidden'>
+        <div
+          aria-hidden='true'
+          className='bg-primary/8 pointer-events-none absolute top-20 left-1/2 size-[28rem] -translate-x-1/2 rounded-full blur-3xl sm:size-[38rem]'
+        />
+        <div
+          aria-hidden='true'
+          className='bg-muted/50 pointer-events-none absolute inset-x-0 top-[28rem] h-64 -skew-y-6'
+        />
+
+        <main className='relative flex flex-1 items-center justify-center px-4 pt-24 pb-16 sm:px-6 sm:pt-28 sm:pb-20'>
+          <section
+            aria-labelledby='contact-title'
+            className='mx-auto flex w-full max-w-xl flex-col items-center text-center'
+          >
+            <div className='border-border/60 bg-background/70 text-muted-foreground mb-4 inline-flex items-center gap-2 rounded-full border px-3 py-1.5 text-xs font-medium shadow-sm backdrop-blur-xl'>
+              <IconWeChat className='size-4 text-[#07c160]' aria-hidden='true' />
+              <span>{t('WeChat')}</span>
+            </div>
+
+            <h1
+              id='contact-title'
+              className='text-3xl font-bold tracking-tight sm:text-4xl'
+            >
+              {t('footer.columns.about.links.contact')}
+            </h1>
+            <p className='text-muted-foreground mt-3 text-sm sm:text-base'>
+              {t('Scan QR Code')}
+            </p>
+
+            <div className='border-border/60 bg-card/80 mt-8 w-full max-w-[27rem] rounded-[2rem] border p-2 shadow-[0_24px_80px_-32px_rgba(0,0,0,0.35)] backdrop-blur-xl sm:p-3 dark:bg-white'>
+              <img
+                src='/contact-wechat.jpg'
+                alt={t('WeChat')}
+                width='592'
+                height='760'
+                decoding='async'
+                className='h-auto w-full rounded-[1.45rem] object-contain'
+              />
+            </div>
+          </section>
+        </main>
+
+        <Footer />
+      </div>
+    </PublicLayout>
+  )
+}
