diff --git a/common/email_template.go b/common/email_template.go
new file mode 100644
index 000000000..f0ad9442b
--- /dev/null
+++ b/common/email_template.go
@@ -0,0 +1,120 @@
+package common
+
+import (
+	"fmt"
+	"html"
+	"os"
+	"strings"
+)
+
+const (
+	defaultEmailSiteURL = "https://suxintoken.com"
+	defaultEmailLogoURL = "https://raw.githubusercontent.com/cnmbdb/new-api/main/customizations/assets/suxintoken-email-logo-white.png"
+)
+
+func accentEmailContent(content string) string {
+	content = strings.ReplaceAll(
+		content,
+		"<strong>",
+		`<strong style="color:#F6821F;font-weight:800;letter-spacing:0.04em;">`,
+	)
+	content = strings.ReplaceAll(
+		content,
+		"<code>",
+		`<code style="color:#F6821F;font-weight:700;">`,
+	)
+	return strings.ReplaceAll(
+		content,
+		"<a ",
+		`<a style="color:#F6821F;font-weight:700;" `,
+	)
+}
+
+func buildBrandedEmailHTML(subject string, content string) string {
+	if strings.Contains(content, `data-new-api-email-card="true"`) {
+		return content
+	}
+
+	brand := strings.TrimSpace(SystemName)
+	if brand == "" {
+		brand = "suxintoken"
+	}
+	siteURL := strings.TrimSpace(os.Getenv("EMAIL_SITE_URL"))
+	if siteURL == "" {
+		siteURL = defaultEmailSiteURL
+	}
+	logoURL := strings.TrimSpace(os.Getenv("EMAIL_LOGO_URL"))
+	if logoURL == "" {
+		logoURL = defaultEmailLogoURL
+	}
+
+	accentedContent := accentEmailContent(content)
+
+	return fmt.Sprintf(`<!DOCTYPE html>
+<html lang="zh-CN">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <meta http-equiv="X-UA-Compatible" content="IE=edge">
+  <meta name="color-scheme" content="light only">
+  <meta name="supported-color-schemes" content="light only">
+  <title>%s</title>
+  <style>
+    .email-content p { margin: 0 0 16px 0; }
+    .email-content p:last-child { margin-bottom: 0; }
+    @media only screen and (max-width: 640px) {
+      .email-shell { padding: 20px 12px !important; }
+      .email-body { padding: 30px 24px 22px !important; }
+      .email-header { padding: 24px !important; }
+    }
+  </style>
+</head>
+<body style="margin:0;padding:0;background-color:transparent;font-family:Arial,Helvetica,sans-serif;color:#292524;">
+  <div style="display:none;max-height:0;overflow:hidden;opacity:0;">%s</div>
+  <table width="100%%" cellpadding="0" cellspacing="0" border="0" role="presentation" style="background-color:transparent;">
+    <tr>
+      <td class="email-shell" align="center" style="padding:40px 16px;">
+        <table data-new-api-email-card="true" width="600" cellpadding="0" cellspacing="0" border="0" role="presentation" style="width:100%%;max-width:600px;background-color:#ffffff;border:1px solid #fed7aa;border-radius:20px;overflow:hidden;box-shadow:0 16px 40px rgba(154,52,18,0.10);">
+          <tr>
+            <td class="email-header" bgcolor="#F6821F" style="padding:28px 34px;background-color:#F6821F!important;background-image:linear-gradient(#F6821F,#F6821F)!important;">
+              <table width="100%%" cellpadding="0" cellspacing="0" border="0" role="presentation">
+                <tr>
+                  <td align="center" valign="middle">
+                    <img src="%s" width="78" height="78" border="0" alt="%s Logo" style="display:block;width:78px;height:78px;border:0;outline:none;text-decoration:none;">
+                  </td>
+                </tr>
+              </table>
+            </td>
+          </tr>
+          <tr>
+            <td class="email-body" style="padding:38px 34px 28px;">
+              <div style="font-size:12px;line-height:18px;font-weight:800;letter-spacing:0.12em;text-transform:uppercase;color:#F6821F;">ACCOUNT MESSAGE</div>
+              <h1 style="margin:8px 0 24px;font-size:25px;line-height:34px;font-weight:800;color:#1c1917;">%s</h1>
+              <div class="email-content" style="font-size:16px;line-height:28px;color:#57534e;">%s</div>
+            </td>
+          </tr>
+          <tr>
+            <td align="center" style="padding:0 34px 36px;">
+              <table cellpadding="0" cellspacing="0" border="0" role="presentation">
+                <tr>
+                  <td align="center" bgcolor="#F6821F" style="border-radius:999px;background-color:#F6821F!important;background-image:linear-gradient(#F6821F,#F6821F)!important;box-shadow:0 8px 20px rgba(246,130,31,0.28);">
+                    <a href="%s" target="_blank" style="display:inline-block;padding:14px 28px;font-size:15px;line-height:20px;font-weight:800;color:#ffffff;text-decoration:none;border-radius:999px;">
+                      <img src="%s" width="18" height="18" border="0" alt="" style="display:inline-block;width:18px;height:18px;border:0;vertical-align:-4px;">&nbsp;&nbsp;前往网站
+                    </a>
+                  </td>
+                </tr>
+              </table>
+            </td>
+          </tr>
+          <tr>
+            <td align="center" style="padding:18px 28px;border-top:1px solid #ffedd5;background-color:#fffaf5;font-size:12px;line-height:18px;color:#a8a29e;">
+              此邮件由 %s 自动发送，请勿直接回复。
+            </td>
+          </tr>
+        </table>
+      </td>
+    </tr>
+  </table>
+</body>
+</html>`,
+		html.EscapeString(subject),
+		html.EscapeString(subject),
+		html.EscapeString(logoURL),
+		html.EscapeString(brand),
+		html.EscapeString(subject),
+		accentedContent,
+		html.EscapeString(siteURL),
+		html.EscapeString(logoURL),
+		html.EscapeString(brand),
+	)
+}
diff --git a/common/email_template_test.go b/common/email_template_test.go
new file mode 100644
index 000000000..b0a3e3e47
--- /dev/null
+++ b/common/email_template_test.go
@@ -0,0 +1,54 @@
+package common
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestBuildBrandedEmailHTMLCreatesOrangeCard(t *testing.T) {
+	t.Setenv("EMAIL_SITE_URL", "https://suxintoken.com/account")
+	t.Setenv("EMAIL_LOGO_URL", "https://cdn.example.com/logo-white.png")
+	originalSystemName := SystemName
+	SystemName = "suxintoken"
+	t.Cleanup(func() { SystemName = originalSystemName })
+
+	result := buildBrandedEmailHTML(
+		"邮箱验证码",
+		"<p>您的验证码为：<strong>123456</strong></p>",
+	)
+
+	require.Contains(t, result, `data-new-api-email-card="true"`)
+	assert.Contains(t, result, `background-color:#F6821F!important`)
+	assert.Contains(t, result, `background-color:transparent`)
+	assert.Contains(t, result, `border:1px solid #fed7aa`)
+	assert.Contains(t, result, `<td align="center" valign="middle">`)
+	assert.Contains(t, result, `src="https://cdn.example.com/logo-white.png" width="78" height="78"`)
+	assert.Contains(t, result, `src="https://cdn.example.com/logo-white.png" width="18" height="18"`)
+	assert.Contains(t, result, `color:#F6821F;font-weight:800`)
+	assert.Contains(t, result, `>123456</strong>`)
+	assert.Contains(t, result, `href="https://suxintoken.com/account"`)
+	assert.Contains(t, result, `前往网站`)
+}
+
+func TestBuildBrandedEmailHTMLUsesSafeFallbacks(t *testing.T) {
+	t.Setenv("EMAIL_SITE_URL", "")
+	t.Setenv("EMAIL_LOGO_URL", "")
+	originalSystemName := SystemName
+	SystemName = "  "
+	t.Cleanup(func() { SystemName = originalSystemName })
+
+	result := buildBrandedEmailHTML(`<Reset & Confirm>`, `<p>Open <a href="/reset">this link</a>.</p>`)
+
+	assert.Contains(t, result, `&lt;Reset &amp; Confirm&gt;`)
+	assert.Contains(t, result, `src="https://raw.githubusercontent.com/cnmbdb/new-api/main/customizations/assets/suxintoken-email-logo-white.png"`)
+	assert.Contains(t, result, `href="https://suxintoken.com"`)
+	assert.Contains(t, result, `style="color:#F6821F;font-weight:700;" href="/reset"`)
+}
+
+func TestBuildBrandedEmailHTMLDoesNotWrapTwice(t *testing.T) {
+	existing := `<table data-new-api-email-card="true"><tr><td>Existing card</td></tr></table>`
+
+	result := buildBrandedEmailHTML("subject", existing)
+
+	assert.Equal(t, existing, result)
+	assert.Equal(t, 1, strings.Count(result, `data-new-api-email-card="true"`))
+}
