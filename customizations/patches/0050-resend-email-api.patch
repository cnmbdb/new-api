@@ -0,0 +1,86 @@
+package common
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestTrySendEmailWithResendDisabled(t *testing.T) {
+	t.Setenv("RESEND_API_KEY", "")
+	t.Setenv("RESEND_FROM", "")
+
+	handled, err := trySendEmailWithResend("subject", "user@example.com", "content")
+
+	require.NoError(t, err)
+	assert.False(t, handled)
+}
+
+func TestTrySendEmailWithResendSuccess(t *testing.T) {
+	t.Setenv("RESEND_API_KEY", "test-api-key")
+	t.Setenv("RESEND_FROM", "New API <noreply@example.com>")
+
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		assert.Equal(t, http.MethodPost, r.Method)
+		assert.Equal(t, "/emails", r.URL.Path)
+		assert.Equal(t, "Bearer test-api-key", r.Header.Get("Authorization"))
+		assert.Equal(t, "application/json", r.Header.Get("Content-Type"))
+		assert.Equal(t, resendUserAgent, r.Header.Get("User-Agent"))
+
+		var payload resendEmailRequest
+		require.NoError(t, DecodeJson(r.Body, &payload))
+		assert.Equal(t, "New API <noreply@example.com>", payload.From)
+		assert.Equal(t, []string{"first@example.com", "second@example.com"}, payload.To)
+		assert.Equal(t, "Verification", payload.Subject)
+		assert.Equal(t, "<strong>code</strong>", payload.HTML)
+
+		w.WriteHeader(http.StatusOK)
+	}))
+	t.Cleanup(server.Close)
+	previousEndpoint := resendAPIEndpoint
+	resendAPIEndpoint = server.URL + "/emails"
+	t.Cleanup(func() { resendAPIEndpoint = previousEndpoint })
+
+	handled, err := trySendEmailWithResend(
+		"Verification",
+		" first@example.com ; second@example.com ",
+		"<strong>code</strong>",
+	)
+
+	require.NoError(t, err)
+	assert.True(t, handled)
+}
+
+func TestTrySendEmailWithResendRequiresFrom(t *testing.T) {
+	t.Setenv("RESEND_API_KEY", "test-api-key")
+	t.Setenv("RESEND_FROM", "")
+
+	handled, err := trySendEmailWithResend("subject", "user@example.com", "content")
+
+	assert.True(t, handled)
+	require.EqualError(t, err, "RESEND_FROM is required when RESEND_API_KEY is configured")
+}
+
+func TestTrySendEmailWithResendReturnsAPIErrorWithoutLeakingKey(t *testing.T) {
+	t.Setenv("RESEND_API_KEY", "secret-api-key")
+	t.Setenv("RESEND_FROM", "noreply@example.com")
+
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		w.WriteHeader(http.StatusUnprocessableEntity)
+		_, _ = w.Write([]byte(`{"message":"domain is not verified"}`))
+	}))
+	t.Cleanup(server.Close)
+	previousEndpoint := resendAPIEndpoint
+	resendAPIEndpoint = server.URL
+	t.Cleanup(func() { resendAPIEndpoint = previousEndpoint })
+
+	handled, err := trySendEmailWithResend("subject", "user@example.com", "content")
+
+	assert.True(t, handled)
+	require.EqualError(t, err, "Resend API returned status 422: domain is not verified")
+	assert.False(t, strings.Contains(err.Error(), "secret-api-key"))
+}
