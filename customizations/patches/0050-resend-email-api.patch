+package common
+
+import (
+	"bytes"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"strings"
+	"time"
+)
+
+const resendUserAgent = "new-api-resend-adapter/1.0"
+
+var resendAPIEndpoint = "https://api.resend.com/emails"
+
+type resendEmailRequest struct {
+	From    string   `json:"from"`
+	To      []string `json:"to"`
+	Subject string   `json:"subject"`
+	HTML    string   `json:"html"`
+}
+
+type resendErrorResponse struct {
+	Message string `json:"message"`
+}
+
+func trySendEmailWithResend(subject string, receiver string, content string) (bool, error) {
+	apiKey := strings.TrimSpace(os.Getenv("RESEND_API_KEY"))
+	if apiKey == "" {
+		return false, nil
+	}
+
+	from := strings.TrimSpace(os.Getenv("RESEND_FROM"))
+	if from == "" {
+		return true, fmt.Errorf("RESEND_FROM is required when RESEND_API_KEY is configured")
+	}
+
+	recipients := make([]string, 0)
+	for _, address := range strings.Split(receiver, ";") {
+		address = strings.TrimSpace(address)
+		if address != "" {
+			recipients = append(recipients, address)
+		}
+	}
+	if len(recipients) == 0 {
+		return true, fmt.Errorf("email receiver is required")
+	}
+
+	payload, err := Marshal(resendEmailRequest{
+		From:    from,
+		To:      recipients,
+		Subject: subject,
+		HTML:    content,
+	})
+	if err != nil {
+		return true, fmt.Errorf("failed to encode Resend email request: %w", err)
+	}
+
+	req, err := http.NewRequest(http.MethodPost, resendAPIEndpoint, bytes.NewReader(payload))
+	if err != nil {
+		return true, fmt.Errorf("failed to create Resend email request: %w", err)
+	}
+	req.Header.Set("Authorization", "Bearer "+apiKey)
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("User-Agent", resendUserAgent)
+
+	client := &http.Client{Timeout: 15 * time.Second}
+	resp, err := client.Do(req)
+	if err != nil {
+		return true, fmt.Errorf("failed to call Resend API: %w", err)
+	}
+	defer resp.Body.Close()
+
+	if resp.StatusCode >= http.StatusOK && resp.StatusCode < http.StatusMultipleChoices {
+		return true, nil
+	}
+
+	body, readErr := io.ReadAll(io.LimitReader(resp.Body, 1<<20))
+	if readErr != nil {
+		return true, fmt.Errorf("Resend API returned status %d", resp.StatusCode)
+	}
+	var apiError resendErrorResponse
+	if err = Unmarshal(body, &apiError); err == nil && strings.TrimSpace(apiError.Message) != "" {
+		return true, fmt.Errorf("Resend API returned status %d: %s", resp.StatusCode, apiError.Message)
+	}
+	return true, fmt.Errorf("Resend API returned status %d", resp.StatusCode)
+}
diff --git a/common/email_resend_test.go b/common/email_resend_test.go
