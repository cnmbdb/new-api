+import { AlertCircle, CheckCircle2, Copy, ExternalLink } from 'lucide-react'
+import { useState } from 'react'
+
+import { PublicLayout } from '@/components/layout'
+import { Badge } from '@/components/ui/badge'
+import { Button } from '@/components/ui/button'
+import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card'
+
+const clients = [
+  [
+    'Cherry Studio / Chatbox',
+    'OpenAI Compatible',
+    '填写站点地址 + /v1，并使用控制台生成的 API Key。',
+  ],
+  [
+    'Claude Code',
+    'ANTHROPIC_BASE_URL',
+    '使用 Claude 兼容端点；模型名称以模型广场显示为准。',
+  ],
+  [
+    'Codex CLI',
+    'OPENAI_BASE_URL',
+    'Base URL 指向站点 /v1，API Key 不要写入公开仓库。',
+  ],
+  [
+    'OpenClaw / Hermes',
+    'Custom Provider',
+    '协议选择 OpenAI Compatible，先用 curl 验证再接入 Agent。',
+  ],
+] as const
+
+const errors = [
+  [
+    '401',
+    '密钥无效或客户端没有读取到环境变量',
+    '重新创建密钥，检查复制时是否带入空格。',
+  ],
+  ['403', '账号、分组或模型权限不足', '检查账户状态、令牌分组及模型权限。'],
+  ['429', '频率或额度限制', '降低并发，稍后重试，并检查余额和令牌限额。'],
+  ['5xx', '平台或上游服务异常', '保存请求时间和 request id 后重试或联系支持。'],
+] as const
+
+function CodeBlock({ children }: { children: string }) {
+  const [copied, setCopied] = useState(false)
+
+  return (
+    <div className='bg-muted/55 relative overflow-x-auto rounded-xl border p-4'>
+      <pre className='pr-12 text-xs leading-6 sm:text-sm'>{children}</pre>
+      <Button
+        type='button'
+        variant='ghost'
+        size='icon'
+        className='absolute top-2 right-2 size-8'
+        aria-label='复制命令'
+        onClick={() => {
+          void navigator.clipboard.writeText(children)
+          setCopied(true)
+          window.setTimeout(() => setCopied(false), 1500)
+        }}
+      >
+        {copied ? (
+          <CheckCircle2 className='size-4' />
+        ) : (
+          <Copy className='size-4' />
+        )}
+      </Button>
+    </div>
+  )
+}
+
+export function Docs() {
+  const curlExample = [
+    'curl "${BASE_URL}/v1/models" \\',
+    '  -H "Authorization: Bearer ${API_KEY}"',
+  ].join('\n')
+
+  return (
+    <PublicLayout>
+      <div className='mx-auto max-w-5xl space-y-12 pt-8 pb-16'>
+        <section className='space-y-4'>
+          <Badge variant='secondary'>内部使用文档</Badge>
+          <h1 className='text-3xl font-bold tracking-tight sm:text-4xl'>
+            API 接入指南
+          </h1>
+          <p className='text-muted-foreground max-w-3xl leading-7'>
+            本站提供 OpenAI 兼容 API。先在控制台创建令牌，再按客户端要求填写
+            Base URL、API Key 和模型名称。
+          </p>
+        </section>
+
+        <section className='grid gap-4 md:grid-cols-3'>
+          {[
+            ['1', '创建令牌', '登录控制台，在令牌管理中创建独立 API Key。'],
+            ['2', '选择模型', '在模型广场确认可用模型及对应分组。'],
+            ['3', '验证调用', '先运行 curl，成功后再配置桌面客户端或 Agent。'],
+          ].map(([step, title, description]) => (
+            <Card key={step}>
+              <CardHeader>
+                <Badge className='w-fit'>{step}</Badge>
+                <CardTitle className='text-lg'>{title}</CardTitle>
+              </CardHeader>
+              <CardContent className='text-muted-foreground text-sm leading-6'>
+                {description}
+              </CardContent>
+            </Card>
+          ))}
+        </section>
+
+        <section className='space-y-4'>
+          <h2 className='text-2xl font-semibold'>快速验证</h2>
+          <CodeBlock>{curlExample}</CodeBlock>
+          <div className='border-primary/25 bg-primary/5 flex gap-3 rounded-xl border p-4 text-sm leading-6'>
+            <AlertCircle className='text-primary mt-0.5 size-5 shrink-0' />
+            <p>
+              不要在截图、日志、公开仓库或聊天群中发送完整 API
+              Key。不同应用建议使用不同令牌。
+            </p>
+          </div>
+        </section>
+
+        <section className='space-y-4'>
+          <h2 className='text-2xl font-semibold'>常用客户端</h2>
+          <div className='grid gap-4 sm:grid-cols-2'>
+            {clients.map(([name, mode, description]) => (
+              <Card key={name}>
+                <CardHeader className='gap-2'>
+                  <CardTitle className='text-lg'>{name}</CardTitle>
+                  <Badge variant='outline' className='w-fit'>
+                    {mode}
+                  </Badge>
+                </CardHeader>
+                <CardContent className='text-muted-foreground text-sm leading-6'>
+                  {description}
+                </CardContent>
+              </Card>
+            ))}
+          </div>
+        </section>
+
+        <section className='space-y-4'>
+          <h2 className='text-2xl font-semibold'>错误排查</h2>
+          <div className='overflow-hidden rounded-xl border'>
+            {errors.map(([code, reason, action]) => (
+              <div
+                key={code}
+                className='grid gap-2 border-t p-4 first:border-t-0 sm:grid-cols-[80px_1fr_1fr]'
+              >
+                <Badge variant='outline' className='h-fit w-fit'>
+                  {code}
+                </Badge>
+                <span className='text-sm'>{reason}</span>
+                <span className='text-muted-foreground text-sm'>{action}</span>
+              </div>
+            ))}
+          </div>
+        </section>
+
+        <a
+          href='https://github.com/QuantumNous/new-api'
+          target='_blank'
+          rel='noopener noreferrer'
+          className='text-primary inline-flex items-center gap-2 text-sm hover:underline'
+        >
+          New API 官方项目 <ExternalLink className='size-4' />
+        </a>
+      </div>
+    </PublicLayout>
+  )
+}
