# syntax=docker/dockerfile:1.7

# The official image supplies the maintained runtime layer. Override this with
# an immutable digest in production, for example:
#   --build-arg OFFICIAL_RUNTIME=calciumion/new-api@sha256:...
ARG OFFICIAL_RUNTIME=calciumion/new-api@sha256:bacbbfbed64b4579213316e0ed78415985223bb20c47fbc24572dd7be5aa1695

FROM oven/bun:1@sha256:0733e50325078969732ebe3b15ce4c4be5082f18c4ac1a0f0ca4839c2e4e42a7 AS web-builder

WORKDIR /build/web
COPY web/package.json web/bun.lock ./
# Low concurrency avoids corrupted tarballs on constrained/proxied builders.
RUN --mount=type=cache,id=new-api-custom-bun-v2,target=/root/.bun/install/cache \
    bun install --frozen-lockfile --network-concurrency 1
COPY web/ ./
COPY VERSION /build/VERSION
RUN DISABLE_ESLINT_PLUGIN=true VITE_REACT_APP_VERSION=$(cat /build/VERSION) bun run build

FROM golang:1.26.1-alpine@sha256:2389ebfa5b7f43eeafbd6be0c3700cc46690ef842ad962f6c5bd6be49ed82039 AS api-builder

ENV CGO_ENABLED=0 GO111MODULE=on GOWORK=off GOEXPERIMENT=greenteagc
ARG TARGETOS=linux
ARG TARGETARCH=amd64
ENV GOOS=${TARGETOS} GOARCH=${TARGETARCH}

WORKDIR /build
COPY go.mod go.sum ./
COPY relaykit/go.mod ./relaykit/go.mod
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY . .
COPY --from=web-builder /build/web/dist ./web/dist
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go build -trimpath -ldflags "-s -w -X 'github.com/QuantumNous/new-api/common.Version=$(cat VERSION)'" -o /out/new-api

FROM ${OFFICIAL_RUNTIME} AS runtime
COPY --from=api-builder /out/new-api /new-api

EXPOSE 3000
WORKDIR /data
ENTRYPOINT ["/new-api"]
